# Debug builds may point at the Android-emulator backend.
EXPO_PUBLIC_API_URL=http://10.0.2.2:8000

# Release admission additionally requires these values from CI/secret storage.
# Do not commit real URLs, keys, passwords, or backend secrets to this file.
# EXPO_PUBLIC_API_URL=https://api.your-production-domain.example
# GUARDIAN_DOH_URL=https://dns.your-production-domain.example/dns-query
# GUARDIAN_POLICY_TRUSTED_PUBLIC_KEYS={"guardian-prod-2026-01":"base64-ed25519-public-key"}
# GUARDIAN_RELEASE_STORE_FILE=/secure/path/guardian-release.jks
# GUARDIAN_RELEASE_STORE_PASSWORD=from-secret-storage
# GUARDIAN_RELEASE_KEY_ALIAS=guardian-release
# GUARDIAN_RELEASE_KEY_PASSWORD=from-secret-storage
# GUARDIAN_JWT_SECRET=from-backend-secret-storage
# GUARDIAN_POLICY_PRIVATE_KEY=from-backend-secret-storage
# GUARDIAN_POLICY_KEY_ID=guardian-prod-2026-01
# GUARDIAN_ENVIRONMENT=production
