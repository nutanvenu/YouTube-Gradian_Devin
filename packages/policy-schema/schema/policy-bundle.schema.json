{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://guardian.family/schema/policy-bundle.schema.json",
  "title": "SignedPolicyBundle",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "policy_version",
    "family_id",
    "child_profile_id",
    "issued_at",
    "expires_soft_at",
    "age_band",
    "base_policy",
    "app_rules",
    "domain_rules",
    "category_rules",
    "routines",
    "temporary_overrides",
    "communication_safety",
    "signature"
  ],
  "properties": {
    "schema_version": {
      "type": "integer",
      "const": 1
    },
    "policy_version": {
      "type": "integer",
      "minimum": 1
    },
    "family_id": {
      "type": "string",
      "minLength": 1
    },
    "child_profile_id": {
      "type": "string",
      "minLength": 1
    },
    "issued_at": {
      "type": "string",
      "format": "date-time"
    },
    "expires_soft_at": {
      "type": "string",
      "format": "date-time"
    },
    "age_band": {
      "$ref": "#/$defs/ageBand"
    },
    "base_policy": {
      "$ref": "#/$defs/basePolicy"
    },
    "app_rules": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/appRule"
      }
    },
    "domain_rules": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/domainRule"
      }
    },
    "category_rules": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/categoryRule"
      }
    },
    "routines": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/routine"
      }
    },
    "temporary_overrides": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/temporaryOverride"
      }
    },
    "communication_safety": {
      "$ref": "#/$defs/communicationSafety"
    },
    "signature": {
      "type": "string",
      "contentEncoding": "base64",
      "minLength": 1
    }
  },
  "$defs": {
    "ageBand": {
      "type": "string",
      "enum": [
        "YOUNG_CHILD",
        "PRETEEN",
        "TEEN",
        "OLDER_TEEN"
      ]
    },
    "category": {
      "type": "string",
      "enum": [
        "ADULT_PORNOGRAPHY",
        "SEXUAL_CONTENT",
        "GAMBLING",
        "DRUGS_CONTROLLED_SUBSTANCES",
        "ALCOHOL_TOBACCO",
        "GRAPHIC_VIOLENCE_GORE",
        "SELF_HARM_SUICIDE",
        "HATE_EXTREMISM",
        "WEAPONS",
        "MALWARE",
        "PHISHING_SCAMS",
        "ANONYMOUS_CHAT",
        "DATING",
        "PROXY_VPN_TOR",
        "PIRACY",
        "SOCIAL_MEDIA",
        "STREAMING_VIDEO",
        "GAMES",
        "SHOPPING",
        "AI_ASSISTANTS",
        "EDUCATION",
        "SEARCH_ENGINES",
        "NEWS",
        "MESSAGING",
        "PRODUCTIVITY",
        "UNKNOWN"
      ]
    },
    "unknownDomainPolicy": {
      "type": "string",
      "enum": [
        "BLOCK",
        "BLOCK_WHILE_CLASSIFYING",
        "ALLOW_WHILE_CLASSIFYING",
        "ALLOW_AND_NOTIFY"
      ]
    },
    "unknownAppPolicy": {
      "type": "string",
      "enum": [
        "BLOCK",
        "LIMIT_AND_NOTIFY",
        "ALLOW_AND_NOTIFY",
        "ALLOW"
      ]
    },
    "action": {
      "type": "string",
      "enum": [
        "ALLOW",
        "BLOCK",
        "UNLIMITED",
        "LIMIT",
        "SCHEDULE",
        "ASK_PARENT"
      ]
    },
    "timeWindow": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "days",
        "start",
        "end"
      ],
      "properties": {
        "days": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "integer",
            "minimum": 1,
            "maximum": 7
          }
        },
        "start": {
          "type": "string",
          "pattern": "^(?:[01][0-9]|2[0-3]):[0-5][0-9]$"
        },
        "end": {
          "type": "string",
          "pattern": "^(?:[01][0-9]|2[0-3]):[0-5][0-9]$"
        }
      }
    },
    "ruleCommon": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "rule_id",
        "action"
      ],
      "properties": {
        "rule_id": {
          "type": "string",
          "minLength": 1
        },
        "action": {
          "$ref": "#/$defs/action"
        },
        "daily_minutes": {
          "type": "integer",
          "minimum": 0
        },
        "schedule": {
          "$ref": "#/$defs/timeWindow"
        },
        "exclude_from_budget": {
          "type": "boolean",
          "default": false
        }
      }
    },
    "appRule": {
      "allOf": [
        {
          "$ref": "#/$defs/ruleCommon"
        },
        {
          "type": "object",
          "required": [
            "app_ref"
          ],
          "properties": {
            "app_ref": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      ]
    },
    "domainRule": {
      "allOf": [
        {
          "$ref": "#/$defs/ruleCommon"
        },
        {
          "type": "object",
          "required": [
            "domain"
          ],
          "properties": {
            "domain": {
              "type": "string",
              "minLength": 1
            },
            "match": {
              "type": "string",
              "enum": [
                "EXACT",
                "SUBDOMAINS"
              ],
              "default": "SUBDOMAINS"
            }
          }
        }
      ]
    },
    "categoryRule": {
      "allOf": [
        {
          "$ref": "#/$defs/ruleCommon"
        },
        {
          "type": "object",
          "required": [
            "category"
          ],
          "properties": {
            "category": {
              "$ref": "#/$defs/category"
            }
          }
        }
      ]
    },
    "routine": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "routine_id",
        "name",
        "window"
      ],
      "properties": {
        "routine_id": {
          "type": "string",
          "minLength": 1
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "window": {
          "$ref": "#/$defs/timeWindow"
        },
        "allowed_apps": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "allowed_categories": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/category"
          }
        },
        "blocked_apps": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "blocked_categories": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/category"
          }
        },
        "web_mode": {
          "type": "string",
          "enum": [
            "BALANCED",
            "STRICT"
          ]
        },
        "communication_mode": {
          "type": "string",
          "enum": [
            "NORMAL",
            "ESSENTIAL_ONLY"
          ]
        }
      }
    },
    "temporaryOverride": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "rule_id",
        "target_kind",
        "target_ref",
        "action",
        "starts_at",
        "expires_at"
      ],
      "properties": {
        "rule_id": {
          "type": "string",
          "minLength": 1
        },
        "target_kind": {
          "type": "string",
          "enum": [
            "APP",
            "DOMAIN",
            "CATEGORY"
          ]
        },
        "target_ref": {
          "type": "string",
          "minLength": 1
        },
        "action": {
          "$ref": "#/$defs/action"
        },
        "daily_minutes": {
          "type": "integer",
          "minimum": 0
        },
        "starts_at": {
          "type": "string",
          "format": "date-time"
        },
        "expires_at": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "basePolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "timezone",
        "unknown_domain_policy",
        "unknown_app_policy",
        "hard_category_rules",
        "default_category_rules",
        "safety_allowlist"
      ],
      "properties": {
        "timezone": {
          "type": "string",
          "minLength": 1
        },
        "unknown_domain_policy": {
          "$ref": "#/$defs/unknownDomainPolicy"
        },
        "unknown_app_policy": {
          "$ref": "#/$defs/unknownAppPolicy"
        },
        "daily_device_budget_minutes": {
          "type": "integer",
          "minimum": 0
        },
        "hard_category_rules": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/categoryRule"
          }
        },
        "default_category_rules": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/categoryRule"
          }
        },
        "safety_allowlist": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "target_kind",
              "target_ref"
            ],
            "properties": {
              "target_kind": {
                "type": "string",
                "enum": [
                  "APP",
                  "DOMAIN",
                  "CATEGORY"
                ]
              },
              "target_ref": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      }
    },
    "communicationSafety": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "enabled",
        "severity_threshold",
        "android_notification_signals",
        "android_accessibility_signals"
      ],
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "severity_threshold": {
          "type": "string",
          "enum": [
            "LOW",
            "MEDIUM",
            "HIGH",
            "CRITICAL"
          ]
        },
        "android_notification_signals": {
          "type": "boolean"
        },
        "android_accessibility_signals": {
          "type": "boolean"
        }
      }
    }
  }
}
